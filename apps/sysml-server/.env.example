# SysML Server
PORT=3001

# Managed project Claude servers are enabled by default.
# Set this to 0 if you want sysml-server to use one already-running upstream server instead.
# SYSML_MANAGE_FORK_SERVERS=1

# Port range for managed `claude server` processes.
# SYSML_AGENT_SERVER_PORT_BASE=35100
# SYSML_AGENT_SERVER_PORT_SPAN=1500

# Upstream Claude server URL when managed mode is disabled.
AGENT_SERVER_URL=http://localhost:3002

# Optional auth token for a static upstream Claude server.
# AGENT_SERVER_AUTH_TOKEN=

# Fallback working directory for direct chat requests without a project.
# AGENT_SERVER_WORK_DIR=./workspace

# SQLite database file path
DB_PATH=./data/sysml.db

# Admin credentials for the API key management UI.
# EASY_SYSML_ADMIN_USERNAME=admin
# EASY_SYSML_ADMIN_PASSWORD=easy-sysml-admin

# ─────────────────────────────────────────────────────────────────────
# AI provider configuration (pass these to the `claude` process)
# ─────────────────────────────────────────────────────────────────────
# DeepSeek (OpenAI-compatible):
#   CLAUDE_CODE_USE_OPENAI_COMPAT=1
#   OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_COMPAT_API_KEY=your-deepseek-api-key
#   OPENAI_COMPAT_PROVIDER=deepseek
#
# Qwen (OpenAI-compatible):
#   CLAUDE_CODE_USE_OPENAI_COMPAT=1
#   OPENAI_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_COMPAT_API_KEY=your-qwen-api-key
#   OPENAI_COMPAT_PROVIDER=qwen
#
# These variables must be set in the environment where sysml-server launches `claude`.
# Verify the CLI is available first:
#   claude --version
#
# If you disable managed mode and run a single upstream server yourself, start it with:
#   claude server --host 127.0.0.1 --port 3002
